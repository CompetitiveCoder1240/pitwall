# PitWall Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file — it is gitignored.

# ── Authentication ────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_string_here

# ── Cloud Databases (Optional for Production) ─────────────────────────────
SUPABASE_URL=postgresql://postgres:password@host:5432/postgres
PINECONE_API_KEY=your-pinecone-api-key

# ── OpenRouter & Google (LLM & Embeddings access) ────────────────────────
# Get OpenRouter key at: https://openrouter.ai/keys
OPENROUTER_API_KEY="your-openrouter-api-key-here"
OPENROUTER_ENDPOINT="https://openrouter.ai/api/v1"

# Get Google key at: https://aistudio.google.com/app/apikey (For text-embedding-004)
GOOGLE_API_KEY="your-google-api-key-here"

# ── LLM model (optional — defaults to the free Nemotron model) ────────────
# LLM_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# ── Frontend → Backend URL ────────────────────────────────────────────────
FASTAPI_URL="http://localhost:8000"

# ── Optional: legacy Flask backend URL (not used in the new stack) ────────
# FLASK_API_URL="http://127.0.0.1:5000"
